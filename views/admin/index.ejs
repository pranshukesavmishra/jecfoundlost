<%- include('../partials/head') %>
<div class="container">
  <h1 style="margin:24px 0 0">Admin</h1>
  <%- include('nav') %>

  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(140px,1fr))">
    <div class="stat"><b><%= counts.open || 0 %></b><span>Open posts</span></div>
    <div class="stat found"><b><%= counts.resolved || 0 %></b><span>Returned</span></div>
    <div class="stat"><b><%= counts.expired || 0 %></b><span>Expired</span></div>
    <div class="stat"><b><%= counts.closed || 0 %></b><span>Closed</span></div>
    <div class="stat"><b><%= counts.last7 || 0 %></b><span>Posts in last 7 days</span></div>
    <div class="stat"><b><%= users %></b><span>Users</span></div>
    <div class="stat"><b><%= subscribers %></b><span>Devices with alerts on</span></div>
  </div>

  <form class="filters" method="get" action="/admin">
    <input type="search" name="q" value="<%= q %>" placeholder="Title, name or phone">
    <select name="status" onchange="this.form.submit()">
      <option value="">All statuses</option>
      <% ['open', 'resolved', 'closed', 'expired'].forEach((s) => { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= STATUS_LABEL[s] %></option><% }) %>
    </select>
    <button class="btn btn-primary">Filter</button>
    <span class="spacer"></span>
  </form>
  <form method="post" action="/admin/run-expiry" style="margin-bottom:12px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn btn-outline btn-sm"><%- icon('clock') %> Run expiry check now</button>
    <span class="muted small">(runs automatically every 15 minutes)</span>
  </form>

  <div class="panel table-wrap">
    <table>
      <thead><tr><th>#</th><th>Post</th><th>Poster</th><th>Status</th><th>Created</th><th>Expires</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (!items.length) { %><tr><td colspan="7" class="muted">No posts.</td></tr><% } %>
        <% items.forEach((i) => { %>
          <tr>
            <td><%= i.id %></td>
            <td><span class="tag tag-<%= i.type %>"><%= i.type %></span> <a href="/items/<%= i.id %>"><%= i.title %></a><div class="muted small"><%= i.category %> · <%= i.response_count %> responses</div></td>
            <td><%= i.poster_name %><div class="muted small"><%= i.poster_phone %></div></td>
            <td><%= STATUS_LABEL[i.status] %><% if (i.closed_by) { %><div class="muted small">by <%= i.closed_by %></div><% } %></td>
            <td class="small"><%= fmtDate(i.created_at) %></td>
            <td class="small"><%= i.status === 'open' ? fmtDate(i.expires_at) : '—' %></td>
            <td>
              <div class="row" style="gap:6px">
                <% if (i.status === 'open') { %>
                  <form method="post" action="/admin/items/<%= i.id %>/close"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm">Close</button></form>
                <% } else { %>
                  <form method="post" action="/admin/items/<%= i.id %>/reopen"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm">Reopen</button></form>
                <% } %>
                <form method="post" action="/admin/items/<%= i.id %>/delete" data-confirm="Delete post #<%= i.id %> permanently?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">Delete</button></form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/foot') %>
