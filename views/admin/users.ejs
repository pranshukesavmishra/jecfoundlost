<%- include('../partials/head') %>
<div class="container">
  <%- include('nav') %>

  <form class="toolbar" method="get" action="/admin/users">
    <div class="input-icon"><%- icon('search') %><input type="search" name="q" value="<%= q %>" placeholder="Search name, phone or enrollment no."></div>
    <button class="btn btn-primary">Search</button>
  </form>

  <div class="panel table-wrap" style="padding:6px">
    <table>
      <thead><tr><th>Person</th><th>Phone</th><th>ID / Department</th><th>Posts</th><th>Joined</th><th>Role</th><th></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr>
            <td><div class="t-item" style="min-width:180px"><span class="avatar" style="--c: <%= avatarColor(u.name) %>"><%= initials(u.name) %></span><div><b style="font-weight:700"><%= u.name %></b><% if (u.email) { %><div class="muted tiny"><%= u.email %></div><% } %></div></div></td>
            <td><%= u.phone %></td>
            <td><%= u.college_id || '—' %><div class="muted tiny"><%= u.department || '' %></div></td>
            <td><%= u.item_count %></td>
            <td class="small"><%= fmtDate(u.created_at) %></td>
            <td>
              <% if (u.is_banned) { %><span class="pill pill-lost">Blocked</span><% } else if (u.role === 'admin') { %><span class="pill pill-open">Admin</span><% } else { %><span class="pill pill-closed">Member</span><% } %>
            </td>
            <td>
              <div class="row" style="gap:6px;flex-wrap:nowrap">
                <form method="post" action="/admin/users/<%= u.id %>/reset" data-confirm="Reset password for <%= u.name %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm"><%- icon('lock') %> Reset</button></form>
                <% if (u.id !== user.id) { %>
                  <% if (u.is_banned) { %>
                    <form method="post" action="/admin/users/<%= u.id %>/unban"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm">Unblock</button></form>
                  <% } else { %>
                    <form method="post" action="/admin/users/<%= u.id %>/ban" data-confirm="Block <%= u.name %>? Their open posts will be closed."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Block</button></form>
                  <% } %>
                  <% if (u.role === 'admin') { %>
                    <form method="post" action="/admin/users/<%= u.id %>/demote"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost">Remove admin</button></form>
                  <% } else { %>
                    <form method="post" action="/admin/users/<%= u.id %>/promote" data-confirm="Make <%= u.name %> an admin?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost">Make admin</button></form>
                  <% } %>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/foot') %>
