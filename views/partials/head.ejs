<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title ? `${title} · ${site.name}` : `${site.name} · ${site.college}` %></title>
  <meta name="description" content="Lost something at <%= site.college %>? Found something? Post it here so the whole campus can help. Powered by the <%= site.poweredBy %>.">
  <meta name="theme-color" content="#1b3a6b">
  <meta name="csrf-token" content="<%= csrf %>">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="<%= site.logo %>">
  <link rel="apple-touch-icon" href="/img/icon-192.png">
  <link rel="stylesheet" href="/css/style.css?v=2">
</head>
<body data-logged-in="<%= user ? '1' : '' %>">
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <img src="<%= site.logo %>" alt="<%= site.college %> logo" width="42" height="42">
      <span class="brand-text">
        <strong><%= site.name %></strong>
        <span><%= site.college %></span>
      </span>
    </a>
    <nav class="nav">
      <span class="nav-desktop">
        <a href="/" class="<%= path === '/' ? 'active' : '' %>">Browse</a>
        <a href="/report/lost" class="<%= path === '/report/lost' ? 'active' : '' %>">I lost something</a>
        <a href="/report/found" class="<%= path === '/report/found' ? 'active' : '' %>">I found something</a>
        <% if (user) { %>
          <a href="/me" class="<%= path === '/me' ? 'active' : '' %>">My posts</a>
          <% if (user.role === 'admin') { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a><% } %>
        <% } %>
      </span>
      <% if (user) { %>
        <a class="bell" href="/me/notifications" aria-label="Notifications">
          <%- icon('bell') %>
          <span class="badge-count <%= unread ? '' : 'hidden' %>" id="unread-count"><%= unread %></span>
        </a>
        <a class="nav-desktop" href="/me/profile" title="<%= user.name %>"><%- icon('user') %></a>
      <% } else { %>
        <a href="/login?next=<%= encodeURIComponent(path) %>">Sign in</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
<% if (flash) { %>
  <div class="container" style="margin-top:16px"><div class="alert alert-ok" role="status"><%= flash %></div></div>
<% } %>
