<% const m = cat(item.category); %>
<a class="card reveal" href="/items/<%= item.id %>">
  <div class="card-media">
    <% if (item.photo) { %>
      <img src="/uploads/<%= item.photo %>" alt="" loading="lazy">
    <% } else { %>
      <%- include('ph', { category: item.category }) %>
    <% } %>
    <span class="pill pill-glass <%= item.type %>"><%= item.type === 'lost' ? 'Lost' : 'Found' %></span>
    <% if (item.status === 'resolved') { %><span class="pill pill-glass done corner">Returned</span><% } %>
  </div>
  <div class="card-body">
    <div class="card-title"><%= item.title %></div>
    <div class="meta"><%- icon('map-pin') %><span><%= item.location %></span></div>
    <div class="meta"><%- icon(m.icon) %><span><%= m.short %> · <%= timeAgo(item.created_at) %></span></div>
    <div class="card-foot">
      <span class="who"><span class="avatar avatar-sm" style="--c: <%= avatarColor(item.poster_name) %>"><%= initials(item.poster_name) %></span><span><%= shortName(item.poster_name) %></span></span>
      <% if (item.status === 'open' && item.response_count) { %>
        <span class="badge-soft hot"><%- icon('message-circle') %><%= item.response_count %></span>
      <% } else if (item.status === 'open') { %>
        <span class="badge-soft"><%- icon('hourglass') %><%= timeLeft(item.expires_at).replace(' left', '') %></span>
      <% } else { %>
        <span class="badge-soft"><%= STATUS_LABEL[item.status] %></span>
      <% } %>
    </div>
  </div>
</a>
