<%- include('partials/head') %>
<% const isLost = type === 'lost'; %>
<div class="container narrow">
  <div style="margin:24px 0 16px">
    <span class="tag tag-<%= type %>"><%= isLost ? 'Lost' : 'Found' %></span>
    <h1 style="margin-top:8px"><%= isLost ? 'Report something you lost' : 'Report something you found' %></h1>
    <p class="muted"><%= isLost
      ? 'Everyone on campus will see this. People who find it can respond, and you will get their number once you confirm.'
      : 'Thank you for helping! The owner can respond with proof, and you choose whether to share numbers.' %></p>
  </div>

  <% if (error) { %><div class="alert alert-error" role="alert" style="margin-bottom:16px"><%= error %></div><% } %>
  <div class="alert alert-error hidden" role="alert" data-form-error style="margin-bottom:16px"></div>

  <form class="panel" method="post" action="/report/<%= type %>" enctype="multipart/form-data" data-photo-form>
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="field">
      <label for="title">What is it?</label>
      <input id="title" type="text" name="title" required minlength="3" maxlength="80" value="<%= form.title || '' %>" placeholder="e.g. Black Casio fx-991ES calculator">
    </div>

    <div class="grid-2 field">
      <div>
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="">Choose…</option>
          <% config.categories.forEach((c) => { %><option <%= form.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="event_date"><%= isLost ? 'When did you lose it?' : 'When did you find it?' %></label>
        <input id="event_date" type="date" name="event_date" max="<%= today %>" value="<%= form.event_date || '' %>">
      </div>
    </div>

    <div class="field">
      <label for="location"><%= isLost ? 'Where did you lose it? (roughly)' : 'Where did you find it?' %></label>
      <input id="location" type="text" name="location" required maxlength="120" list="places" value="<%= form.location || '' %>" placeholder="e.g. Central Library, 2nd floor">
      <datalist id="places"><% config.places.forEach((p) => { %><option value="<%= p %>"><% }) %></datalist>
    </div>

    <div class="field">
      <label for="description">Details <span class="hint">(colour, brand, stickers, what was inside…)</span></label>
      <textarea id="description" name="description" maxlength="1500" placeholder="<%= isLost ? 'e.g. Blue cover with my name on the back. Has a cracked corner.' : 'Describe it, but keep one detail secret (below) so you can check the real owner.' %>"><%= form.description || '' %></textarea>
    </div>

    <% if (!isLost) { %>
      <div class="field">
        <label>Where is the item now?</label>
        <div class="radio-cards">
          <label><input type="radio" name="handover" value="me" <%= form.handover === 'me' || !form.handover ? 'checked' : '' %>>
            <span>I'm keeping it — the owner can contact me<br><span class="hint">Your number is shared only after you confirm the owner.</span></span></label>
          <% collectionPoints.forEach((p) => { %>
            <label><input type="radio" name="handover" value="<%= p %>" <%= form.handover === p ? 'checked' : '' %>>
              <span>Deposited at <strong><%= p %></strong></span></label>
          <% }) %>
        </div>
      </div>

      <div class="field">
        <label for="secret_detail">Secret detail <span class="hint">(optional — only you and admins see this)</span></label>
        <input id="secret_detail" type="text" name="secret_detail" maxlength="300" value="<%= form.secret_detail || '' %>" placeholder="e.g. ₹200 inside, lock-screen photo is a dog">
      </div>
    <% } %>

    <div class="field">
      <label for="photos">Photos <span class="hint">(up to <%= config.MAX_PHOTOS %><%= isLost ? ', if you have any' : '' %>)</span></label>
      <div class="photo-picker">
        <input id="photos" type="file" name="photos" accept="image/*" multiple data-max="<%= config.MAX_PHOTOS %>">
        <div class="photo-previews" data-previews></div>
        <p class="muted small" style="margin:8px 0 0"><%= isLost ? 'An old photo of the item (or a similar one) helps people recognise it.' : 'Clear photos help the owner recognise it. Avoid showing ID numbers or card details.' %></p>
      </div>
    </div>

    <p class="muted small" style="margin-top:16px">
      This post closes automatically after <%= isLost ? config.LOST_EXPIRY_DAYS : config.FOUND_EXPIRY_DAYS %> days. You can extend it or close it earlier.
    </p>
    <button class="btn <%= isLost ? 'btn-lost' : 'btn-found' %> btn-block" style="margin-top:8px">Post &amp; notify everyone</button>
  </form>
</div>
<%- include('partials/foot') %>
