<%- include('partials/head') %>
<div class="container narrow" style="max-width:520px">
  <div class="panel" style="margin-top:32px">
    <h1>Create your account</h1>
    <p class="muted small">For JEC students and staff. Your mobile number stays private: it is only shared with the other person after a lost/found match is confirmed.</p>
    <% if (error) { %><div class="alert alert-error" role="alert" style="margin-bottom:12px"><%= error %></div><% } %>
    <form method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label for="name">Full name</label>
        <input id="name" type="text" name="name" autocomplete="name" required maxlength="80" value="<%= form.name || '' %>">
      </div>
      <div class="grid-2 field">
        <div>
          <label for="phone">Mobile number <span class="hint">(WhatsApp preferred)</span></label>
          <input id="phone" type="tel" name="phone" inputmode="numeric" autocomplete="tel" required value="<%= form.phone || '' %>" placeholder="10-digit number">
        </div>
        <div>
          <label for="college_id">Enrollment no. / Employee ID</label>
          <input id="college_id" type="text" name="college_id" required maxlength="40" value="<%= form.college_id || '' %>">
        </div>
      </div>
      <div class="field">
        <label for="department">Department</label>
        <select id="department" name="department" required>
          <option value="">Choose…</option>
          <% config.departments.forEach((d) => { %><option <%= form.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="email">E-mail <span class="hint">(optional)</span></label>
        <input id="email" type="email" name="email" autocomplete="email" maxlength="120" value="<%= form.email || '' %>">
      </div>
      <div class="grid-2 field">
        <div>
          <label for="password">Password</label>
          <input id="password" type="password" name="password" autocomplete="new-password" minlength="6" required>
        </div>
        <div>
          <label for="password2">Repeat password</label>
          <input id="password2" type="password" name="password2" autocomplete="new-password" minlength="6" required>
        </div>
      </div>
      <button class="btn btn-primary btn-block" style="margin-top:16px">Create account</button>
    </form>
    <p class="small center" style="margin-top:16px">Already registered? <a href="/login?next=<%= encodeURIComponent(next) %>">Sign in</a></p>
  </div>
</div>
<%- include('partials/foot') %>
