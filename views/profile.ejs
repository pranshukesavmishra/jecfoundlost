<%- include('partials/head') %>
<div class="container narrow" style="max-width:640px">
  <div class="page-head">
    <span class="avatar avatar-lg" style="--c: <%= avatarColor(user.name) %>"><%= initials(user.name) %></span>
    <div><h1>Profile</h1><p><%= user.phone %> · <%= user.department || '' %></p></div>
  </div>
  <% if (error) { %><div class="alert alert-error" role="alert" style="margin-bottom:16px"><%- icon('circle-alert') %><span><%= error %></span></div><% } %>

  <div class="panel" style="margin-bottom:16px">
    <div class="panel-title"><span class="step-num"><%- icon('sun-moon') %></span><div><h3>Appearance</h3><p>Saved on this device</p></div></div>
    <div class="mode-switch" role="group" aria-label="Appearance">
      <button type="button" data-mode-set="auto"><%- icon('monitor-smartphone') %> Auto</button>
      <button type="button" data-mode-set="light"><%- icon('sun') %> Light</button>
      <button type="button" data-mode-set="dark"><%- icon('moon') %> Dark</button>
    </div>
  </div>

  <div class="panel" style="margin-bottom:16px">
    <div class="panel-title"><span class="step-num"><%- icon('bell-ring') %></span><div><h3>Alerts on this device</h3><p data-push-status>Checking…</p></div></div>
    <div class="row">
      <button class="btn btn-primary btn-sm" data-push-enable data-scope="all"><%- icon('bell-ring') %> Every new post</button>
      <button class="btn btn-sm" data-push-enable data-scope="mine"><%- icon('user') %> Only my posts</button>
      <button class="btn btn-sm btn-ghost" data-push-disable>Turn off</button>
    </div>
  </div>

  <form class="panel" method="post" action="/me/profile">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="panel-title"><span class="step-num"><%- icon('user') %></span><div><h3>Your details</h3><p>Your mobile number is only shared after you confirm a match.</p></div></div>
    <div class="field">
      <label>Mobile number</label>
      <div class="input-icon"><%- icon('smartphone') %><input type="text" value="<%= user.phone %>" disabled></div>
      <div class="hint" style="margin-top:6px">To change it, ask an admin.</div>
    </div>
    <div class="field">
      <label for="name">Full name</label>
      <div class="input-icon"><%- icon('user') %><input id="name" type="text" name="name" required maxlength="80" value="<%= user.name %>"></div>
    </div>
    <div class="grid-2 field">
      <div>
        <label for="department">Department</label>
        <select id="department" name="department">
          <% config.departments.forEach((d) => { %><option <%= user.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="email">E-mail <span class="hint">· optional</span></label>
        <input id="email" type="email" name="email" maxlength="120" value="<%= user.email || '' %>">
      </div>
    </div>
    <div class="divider" style="height:1px;background:var(--line);margin:24px 0"></div>
    <h3>Change password <span class="hint">· leave empty to keep it</span></h3>
    <div class="grid-2" style="margin-top:12px">
      <div><label for="cp">Current password</label><input id="cp" type="password" name="current_password" autocomplete="current-password"></div>
      <div><label for="np">New password</label><input id="np" type="password" name="new_password" minlength="6" autocomplete="new-password"></div>
    </div>
    <button class="btn btn-primary" style="margin-top:22px"><%- icon('check') %> Save changes</button>
  </form>

  <form method="post" action="/logout" style="margin-top:16px;text-align:center">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn btn-ghost"><%- icon('log-out') %> Sign out</button>
  </form>
</div>
<%- include('partials/foot') %>
