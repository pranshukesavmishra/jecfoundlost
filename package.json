{
  "name": "jec-lost-found",
  "version": "1.0.0",
  "private": true,
  "description": "Lost & Found portal for Jabalpur Engineering College — powered by the Department of Mechatronics Engineering",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
