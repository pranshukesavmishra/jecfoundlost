    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "web-push": "^3.6.7"
  }
}
