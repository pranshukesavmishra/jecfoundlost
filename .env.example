# Copy to .env (or set these in your hosting dashboard).

PORT=3000
NODE_ENV=production
# Public address of the site — used in share links and to enable secure cookies when it starts with https://
BASE_URL=https://lostfound.example.com
# Set to 1 when running behind Nginx / Render / Railway etc.
TRUST_PROXY=1
# Where the database and photos are stored (mount a persistent volume here)
DATA_DIR=./data

# First admin account (created / updated on every start)
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Mechatronics Admin

# Ticket lifetime
LOST_EXPIRY_DAYS=15
FOUND_EXPIRY_DAYS=30
REMINDER_DAYS_BEFORE=2
MAX_EXTENSIONS=2
MAX_POSTS_PER_DAY=10

# Contact for browser push services
VAPID_SUBJECT=mailto:mechatronics@jecjabalpur.ac.in
